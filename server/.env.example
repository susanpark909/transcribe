# Required — used to transcribe audio and video:
# get from https://www.assemblyai.com/app/api-keys
ASSEMBLYAI_API_KEY=

# Required — this app stores its data (transcripts, saved course logins) in
# Supabase instead of a local file, so it works the same locally and deployed.
# Get both from your Supabase project: Settings > Data API (for the URL) and
# Settings > API Keys (for the service_role secret key — NOT the publishable
# one; the service_role key is what lets the server bypass Row Level Security).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=8787

# Required before deploying this publicly (leave blank for local-only use).
# Without it, anyone with the URL could use your AssemblyAI credits and see/
# delete your transcripts. Pick any password; the username doesn't matter.
APP_PASSWORD=

# Optional, local development only: lets yt-dlp read cookies live from a
# browser you're logged into (chrome, edge, firefox, brave) as a fallback
# when no saved login exists yet for a site. Does nothing when deployed —
# there's no browser on the server. The reliable way to save a login for any
# environment is via the app's own "needs login" flow, which stores it in
# Supabase instead.
YTDLP_COOKIES_BROWSER=
